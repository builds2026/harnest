{
  "name": "@harnestai/protocol",
  "version": "0.2.0-beta.2",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/wire.json": "./schema/wire.schema.json",
    "./schema/command.json": "./schema/command.schema.json",
    "./schema/create-run.json": "./schema/create-run.schema.json",
    "./schema/idempotency-key.json": "./schema/idempotency-key.schema.json",
    "./schema/interaction.json": "./schema/interaction.schema.json",
    "./schema/permission.json": "./schema/permission.schema.json",
    "./schema/snapshot-response.json": "./schema/snapshot-response.schema.json",
