{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "input": {},
    "resumeRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "context": {
      "type": "object",
      "properties": {
        "contextRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revisions": {
          "type": "object",
          "properties": {
            "conversation": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "number"
                }
              ]
            },
            "memory": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "number"
                }
              ]
            },
            "pkm": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "attachments": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "mimeType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 127,
                "pattern": "^[\\w.+-]+\\/[\\w.+-]+$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 67108864
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "ref",
              "name",
              "mimeType",
              "size",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "contextRef"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "input"
  ],
  "additionalProperties": false
}
