{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "type": {
          "type": "string",
          "const": "message"
        },
        "target": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "run",
                "team",
                "agent"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      },
      "required": [
        "type",
        "target",
        "content"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "type": {
          "type": "string",
          "const": "task-directive"
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "required": [
        "type",
        "taskId",
        "instruction"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "type": {
          "type": "string",
          "const": "plan-patch"
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "operations": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "add",
                  "update",
                  "cancel"
                ]
              },
              "taskId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "goal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "assignee": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "dependsOn": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                }
              }
            },
            "required": [
              "op",
              "taskId"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "baseRevision",
        "reason",
        "operations"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "type": {
          "type": "string",
          "const": "cancel"
        },
        "scope": {
          "type": "string",
          "enum": [
            "run",
            "task",
            "agent"
          ]
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      },
      "required": [
        "type",
        "scope"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "type": {
          "type": "string",
          "const": "interaction.response"
        },
        "response": {
          "type": "object",
          "properties": {
            "interactionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "checkpointDigest": {
              "type": "string",
              "minLength": 16,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "action": {
              "type": "string",
              "enum": [
                "submit",
                "decline",
                "cancel"
              ]
            },
            "value": {},
            "permission": {
              "type": "string",
              "enum": [
                "allow_once",
                "allow_for_run",
                "allow_always",
                "deny"
              ]
            }
          },
          "required": [
            "interactionId",
            "checkpointDigest",
            "action"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "response"
      ],
      "additionalProperties": false
    }
  ]
}
