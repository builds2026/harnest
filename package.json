{
  "name": "harnest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.15.0"
  },
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "build:packages": "tsc -b",
    "build": "npm run build:packages && npm run build --workspace @harnestai/studio",
    "typecheck": "tsc -b && npm run typecheck --workspace @harnestai/studio",
    "test": "npm run build:packages && vitest run --exclude \"**/dist/**\" --exclude \"frontend/e2e/**\"",
    "test:python": "uv run --project python --extra test pytest -q",
    "test:e2e": "npm run e2e --workspace @harnestai/studio && npm run e2e:runtime --workspace @harnestai/studio",
    "quality": "npm run lint && npm run typecheck && npm test && npm run test:python && npm run build && npm run test:e2e",
    "lint": "eslint .",
    "smoke:container": "npm run build:packages && node examples/runtime-e2e/container-smoke.mjs",
    "studio": "npm run harnest -- studio harnest.yaml",
    "harnest": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "description": "Harnest is an open-source Visual Graph Engineering Platform for AI agent harnesses. Design typed components, branches, parallel joins, reusable subgraphs, bounded loops, tools, and evaluators in the Web Studio, then run the same `harnest.yaml` through the CLI or TypeScript API.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "dependencies": {
